[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 25,Cursors

[Scheme.Cur]
Alternate_1.cur
EWResize_2.cur
Help.cur
Link_1.cur
Move.cur
NEResize.cur
Normal_1.cur
NotAllowed_1.cur
NSResize_1.cur
NWResize.cur
Precision.cur
Text.cur
AppStarting_32-48-64.ani
Wait_32-48-64.ani

[Scheme.Reg]
HKCU,"Control Panel\Cursors","UpArrow",,"%25%\Cursors\Alternate_1.cur"
HKCU,"Control Panel\Cursors","SizeWE",,"%25%\Cursors\EWResize_2.cur"
HKCU,"Control Panel\Cursors","Help",,"%25%\Cursors\Help.cur"
HKCU,"Control Panel\Cursors","Hand",,"%25%\Cursors\Link_1.cur"
HKCU,"Control Panel\Cursors","SizeAll",,"%25%\Cursors\Move.cur"
HKCU,"Control Panel\Cursors","SizeNESW",,"%25%\Cursors\NEResize.cur"
HKCU,"Control Panel\Cursors","Arrow",,"%25%\Cursors\Normal_1.cur"
HKCU,"Control Panel\Cursors","No",,"%25%\Cursors\NotAllowed_1.cur"
HKCU,"Control Panel\Cursors","SizeNS",,"%25%\Cursors\NSResize_1.cur"
HKCU,"Control Panel\Cursors","SizeNWSE",,"%25%\Cursors\NWResize.cur"
HKCU,"Control Panel\Cursors","Cross",,"%25%\Cursors\Precision.cur"
HKCU,"Control Panel\Cursors","IBeam",,"%25%\Cursors\Text.cur"
HKCU,"Control Panel\Cursors","AppStarting",,"%25%\Cursors\AppStarting_32-48-64.ani"
HKCU,"Control Panel\Cursors","Wait",,"%25%\Cursors\Wait_32-48-64.ani"
; Set scheme name
HKCU,"Control Panel\Cursors","(Default)",,"PixelFun 2"
HKCU,"Control Panel\Cursors\Schemes","PixelFun 2",,""